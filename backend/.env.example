NODE_ENV=development
PORT=4000

# SQL Server (primary target; Oracle supported via ORACLE_* vars below)
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=fitment_catalog
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# Oracle (optional secondary dialect - set DB_DIALECT=oracle to switch)
ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1
ORACLE_USER=fitment_app
ORACLE_PASSWORD=change_me

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fitment-catalog-backend
KAFKA_GROUP_ID=fitment-catalog-consumers
KAFKA_FITMENT_TOPIC=fitment.events
KAFKA_SSL=false

# Auth
JWT_SECRET=change_me_in_production

# Batch/ETL
ETL_BATCH_SIZE=1000
ETL_CRON_SCHEDULE=0 */2 * * *
